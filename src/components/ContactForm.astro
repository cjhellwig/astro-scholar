---
// src/components/ContactForm.astro
export interface Props {
  source?: string;
}

const { source = "General Contact Page" } = Astro.props;
---

<form action="https://api.web3forms.com/submit" method="POST" class="contact-form">
  <!-- Paste your Web3Forms Access Key here -->
  <input type="hidden" name="access_key" value="5e5acae5-46d9-4ead-bce8-3aecfc1322f6">

  <!-- Email Subject Line -->
  <input type="hidden" name="subject" value={`New Inquiry: ${source}`}>

  <!-- Hidden field that passes the campaign/page source to your email -->
  <input type="hidden" name="Landing_Page" value={source}>

  <div class="form-group">
    <label for="name">Your Name</label>
    <input type="text" id="name" name="name" required />
  </div>

  <div class="form-group">
    <label for="email">Your Email</label>
    <input type="email" id="email" name="email" required />
  </div>

  <div class="form-group">
    <label for="subject-matter">Student Subject / Level</label>
    <input type="text" id="subject-matter" name="student_info" placeholder="e.g., Calculus, Physics" />
  </div>

  <div class="form-group">
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="5" required></textarea>
  </div>

  <!-- Honeypot Spam Protection -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

  <button type="submit">Send Message</button>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 500px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  input, textarea {
    padding: 0.5rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font: inherit;
  }
  button {
    padding: 0.75rem;
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
  }
  button:hover {
    background-color: #1d4ed8;
  }
  .hidden {
    display: none;
  }
</style>
