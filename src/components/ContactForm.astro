---
// src/components/ContactForm.astro
export interface Props {
  source?: string;
}

const { source = "General Contact Page" } = Astro.props;
---

<form action="https://api.web3forms.com/submit" method="POST" class="contact-form">
  <!-- Paste your Web3Forms Access Key here -->
  <input type="hidden" name="access_key" value="5e5acae5-46d9-4ead-bce8-3aecfc1322f6">

  <!-- Email Subject Line -->
  <input type="hidden" name="subject" value={`New Inquiry: ${source}`}>

  <!-- Hidden field that passes the campaign/page source to your email -->
  <input type="hidden" name="Landing_Page" value={source}>

  <div class="form-group">
    <label for="name">Your Name</label>
    <input type="text" id="name" name="name" required />
  </div>

  <div class="form-group">
    <label for="email">Your Email</label>
    <input type="email" id="email" name="email" required />
  </div>

  <div class="form-group">
    <label for="subject-matter">Student Subject / Level</label>
    <input type="text" id="subject-matter" name="student_info" placeholder="e.g., Calculus, Physics" />
  </div>

  <div class="form-group">
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="5" required></textarea>
  </div>

  <!-- Honeypot Spam Protection -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

  <button type="submit">Submit Form</button>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 500px;
    margin-top: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  label {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  input, textarea {
    padding: 0.75rem;
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    font: inherit;
    transition: border-color var(--transition-fast);
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

button {
    padding: 0.75rem;
    background-color: #334155; /* A balanced, professional slate grey for day mode */
    color: #ffffff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    font-size: 1rem;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  /* Softer, balanced grey for dark mode so it isn't blinding white */
  [data-theme="dark"] button {
    background-color: #475569; 
    color: #f8fafc;
  }

  @media (hover: hover) {
    button:hover {
      background-color: var(--color-accent);
      transform: translateY(-1px);
    }
  }

  button:active {
    background-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .hidden {
    display: none;
  }
</style>
