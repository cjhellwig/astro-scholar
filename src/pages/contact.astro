---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { SITE_DATA } from '../constants';
import portraitImage from '../assets/portrait.png';

import ContactForm from '../components/ContactForm.astro';

import '../styles/about.css';
---

<Layout pageTitle="Contact">
    <div class="page-container">
        <h1>Contact</h1>

        <div class="about-content">
            <div class="about-intro-wrapper centered-column">
                <div class="about-header centered-column">
                    <Image src={portraitImage} alt={SITE_DATA.name} class="about-portrait" />
                    <h2 class="about-name">{SITE_DATA.name}</h2>
                </div>

                <p class="intro-text">
                    If you have any questions or if you'd like to schedule an appointment, you can email me at
                    <a href={`mailto:${SITE_DATA.email}`}>cjhellwig@gmail.com</a>, or text or call me at 718-753-7060. Or, if you'd prefer, use the contact form below.              
                    <br><br>
                    I only take on a limited number of students, so that when finals and AP exams roll around, I have plenty of open hours to give everyone extra support. Reserve your preferred timeslot today before my schedule fills up!
                </p>
            </div>
        </div>
        <div class="contact-form-section">
            <ContactForm/>
        </div>

    </div>
</Layout>

<style>
  /* Forces the contact page intro to stay stacked vertically on all screen sizes */
  @media (min-width: 768px) {
    .page-container .about-intro-wrapper {
      flex-direction: column !important;
      align-items: center !important;
    }
  }
</style>
