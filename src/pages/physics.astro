---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import { SITE_DATA } from '../constants';
import '../styles/about.css'; // Reusing your about/content text styles for clean typography
---

<LandingLayout title="Expert Physics Tutor in NYC">
	
	<LandingHero 
		name={SITE_DATA.name}
		headline="Master Physics with a 20+ Year Expert."
		subheadline="Individualized 1-on-1 instruction for AP Physics, mechanics, electromagnetism, and college coursework in Manhattan & Online."
	/>

	<div class="page-container">
		<div class="about-content" style="max-width: 800px; margin: 0 auto;">
			
			<section>
				<h2>Why Work With Me?</h2>
				<p class="intro-text">
					Unlike generic tutoring agencies that rotate graduate students through your schedule, you work directly with me—an experienced educator with over two decades of experience breaking down complex math and science concepts for NYC students. My approach is deeply patient, highly encouraging, and entirely tailored to how you learn.
				</p>
			</section>

			<section>
				<h2>Physics Courses Covered</h2>
				<ul class="education-list icon-list">
					<li>
						<span class="list-item-title">AP Physics (1, 2, & C: Mechanics / E&M)</span>
						<span class="list-item-description">Rigorous preparation for exams, conceptual foundations, and advanced problem-solving techniques.</span>
					</li>
					<li>
						<span class="list-item-title">College & University Physics</span>
						<span class="list-item-description">Algebra-based and calculus-based university physics support for pre-med and engineering tracks.</span>
					</li>
					<li>
						<span class="list-item-title">Targeted Problem Sets</span>
						<span class="list-item-description">Customized practice and reference sheets designed around your exact syllabus to ensure lasting mastery.</span>
					</li>
				</ul>
			</section>

			<!-- Contact Section matching your site style -->
			<section id="contact" style="margin-top: 3rem; text-align: center; background: rgba(0,0,0,0.02); padding: 2.5rem; border-radius: 8px;">
				<h2>Ready to Improve Your Physics Grade?</h2>
				<p style="margin: 1rem 0 1.5rem 0;">
					If you have any questions or if you'd like to schedule an appointment, you can email me at 
					<a href={`mailto:${SITE_DATA.email}`}>{SITE_DATA.email}</a>, or text/call at 718-753-7060.
				</p>
				<a href={`mailto:${SITE_DATA.email}`} class="landing-btn-primary" style="display: inline-block;">Send an Inquiry</a>
			</section>

		</div>
	</div>

</LandingLayout>
