---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHero from '../components/LandingHero.astro';
import { SITE_DATA } from '../constants';
import '../styles/about.css'; // Uses your authentic about page styling
---

<LandingLayout title="Expert Physics Tutor in NYC">
	
	<LandingHero 
		name={SITE_DATA.name}
		headline="Master Physics with a 20+ Year Expert."
		subheadline="Individualized 1-on-1 instruction for AP Physics, mechanics, electromagnetism, and college coursework in Manhattan & Online."
	/>

	<main class="page-container">
		<div class="about-content" style="max-width: 800px; margin: 0 auto;">
			
			<section style="margin-bottom: 3.5rem;">
				<h2>Why Work With Me?</h2>
				<p class="intro-text" style="line-height: 1.7; font-size: 1.05rem;">
					Unlike generic tutoring agencies that rotate graduate students through your schedule, you work directly with me—an experienced educator with over two decades of experience breaking down complex math and science concepts for NYC students. My approach is deeply patient, highly encouraging, and entirely tailored to how you learn.
				</p>
			</section>

			<section style="margin-bottom: 3.5rem;">
				<h2>Physics Courses Covered</h2>
				<ul class="icon-list education-list">
					<li>
						<div class="list-entry">
							<h3>AP Physics (1, 2, &amp; C: Mechanics / E&amp;M)</h3>
							<p class="institution">Rigorous preparation for exams &amp; conceptual foundations</p>
							<p>Advanced problem-solving techniques tailored to your school's curriculum and exam board standards.</p>
						</div>
					</li>
					<li>
						<div class="list-entry">
							<h3>College &amp; University Physics</h3>
							<p class="institution">Algebra &amp; Calculus-Based Tracks</p>
							<p>Dedicated university physics support for pre-med, architecture, and engineering majors.</p>
						</div>
					</li>
					<li>
						<div class="list-entry">
							<h3>Targeted Problem Sets</h3>
							<p class="institution">Customized Practice Materials</p>
							<p>Personalized problem sets and reference sheets designed around your exact syllabus to ensure lasting mastery.</p>
						</div>
					</li>
				</ul>
			</section>

			<!-- Contact Section matching your site style -->
			<section id="contact" style="margin-top: 3.5rem; text-align: center; background: rgba(0,0,0,0.02); padding: 3rem 2rem; border-radius: 8px; border: 1px solid rgba(0,0,0,0.05);">
				<h2 style="margin-bottom: 1rem;">Ready to Improve Your Physics Grade?</h2>
				<p style="margin: 0 0 1.75rem 0; line-height: 1.6;">
					If you have any questions or if you'd like to schedule an appointment, you can email me at 
					<a href={`mailto:${SITE_DATA.email}`}>{SITE_DATA.email}</a>, or text/call at 718-753-7060.
				</p>
				<a href={`mailto:${SITE_DATA.email}`} class="landing-btn-primary" style="display: inline-block;">Send an Inquiry</a>
			</section>

		</div>
	</main>

</LandingLayout>
