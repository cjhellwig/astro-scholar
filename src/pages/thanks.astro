---
import Layout from '../layouts/MinimalLayout.astro';
import Hero from '../components/Hero.astro';
import { SITE_DATA } from '../constants';

import ContactForm from '../components/ContactForm.astro';

import '../styles/home.css';
import '../styles/about.css';
---

<Layout pageTitle="Thanks!">

    <div class="page-container">
        <div class="about-content">
            <div class="about-intro-wrapper centered-column">
                <h2>Thank you! Your request has been received.</h2>

                <p class="intro-text">
                    Thanks for reaching out about physics tutoring. I appreciate you taking the time to share your details. I'll get back to you as soon as possible to discuss next steps. 
                </p>
            </div>
        </div>
	</div>
</Layout>
