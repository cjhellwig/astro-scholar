---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { SITE_DATA } from '../constants';
import portraitImage from '../assets/portrait.png';

import { YouTube } from '@astro-community/astro-embed-youtube';

import '../styles/about.css';
---

<Layout pageTitle="Video">
    <div class="page-container">
        <h1>Instructional Video</h1>
                <p>
                    I made this educational video about prime numbers so prospective students can get an idea of my teaching style. In it, I use the same setup that I use during my Zoom tutoring sessions. I hope you enjoy it and learn something new!
                </p>
                <div class="video-wrapper">
                    <YouTube id="https://youtu.be/CSE6gm5-8Zw" />
                </div>
        </div>
    </div>
</Layout>

<style>
	.video-wrapper {
		margin-top: 2rem;    /* Adds space between the paragraph and the video */
		margin-bottom: 2rem; /* Adds space below the video */
	}
</style>
